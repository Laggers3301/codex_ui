# Non-root task-local TeX Live installation. Packages are added with tlmgr after bootstrap.
selected_scheme scheme-small
TEXDIR /home/example/codex_zerotier_remote/runtime/document-tools/texlive/2026
TEXMFLOCAL /home/example/codex_zerotier_remote/runtime/document-tools/texlive/texmf-local
TEXMFSYSCONFIG /home/example/codex_zerotier_remote/runtime/document-tools/texlive/2026/texmf-config
TEXMFSYSVAR /home/example/codex_zerotier_remote/runtime/document-tools/texlive/2026/texmf-var
TEXMFCONFIG /home/example/codex_zerotier_remote/runtime/document-tools/texlive/texmf-config
TEXMFVAR /home/example/codex_zerotier_remote/runtime/document-tools/texlive/texmf-var
TEXMFHOME /home/example/codex_zerotier_remote/runtime/document-tools/texlive/texmf-home
binary_x86_64-linux 1
instopt_adjustpath 0
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0
