# Non-root task-local TeX Live installation. Packages are added with tlmgr after bootstrap.
selected_scheme scheme-small
TEXDIR @DOCUMENT_TOOLS_ROOT@/texlive/2026
TEXMFLOCAL @DOCUMENT_TOOLS_ROOT@/texlive/texmf-local
TEXMFSYSCONFIG @DOCUMENT_TOOLS_ROOT@/texlive/2026/texmf-config
TEXMFSYSVAR @DOCUMENT_TOOLS_ROOT@/texlive/2026/texmf-var
TEXMFCONFIG @DOCUMENT_TOOLS_ROOT@/texlive/texmf-config
TEXMFVAR @DOCUMENT_TOOLS_ROOT@/texlive/texmf-var
TEXMFHOME @DOCUMENT_TOOLS_ROOT@/texlive/texmf-home
binary_x86_64-linux 1
instopt_adjustpath 0
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0
