{
  "name": "codex-web-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run src server && node --test scripts/install-document-authoring-skill.test.mjs scripts/preserve-auth-failures.test.cjs",
    "serve": "tsx server/index.ts",
    "generate:codex-schema": "node scripts/generate-codex-schema.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^10.0.0",
    "@icon-park/svg": "^1.4.2",
    "@superdoc-dev/react": "1.15.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror-lang-latex": "^0.6.1",
    "docx-preview": "^0.4.1",
    "fastify": "^5.4.0",
    "fflate": "^0.8.3",
    "katex": "0.16.22",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remend": "^1.3.1",
    "superdoc": "1.30.0",
    "vite": "^7.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
